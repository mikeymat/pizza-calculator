# ---------------------------------------------------------------------------
# Configurazione dell'istanza Kestra. Copia questo file in `.env` (o esegui
# `make setup`, che lo genera con password casuali) e adattalo.
# `.env` NON va committato: contiene le credenziali.
# ---------------------------------------------------------------------------

# Versione di Kestra (v2.0.0 e' l'ultima LTS). Tag disponibili su hub.docker.com/r/kestra/kestra
KESTRA_VERSION=v2.0.0
POSTGRES_VERSION=16-alpine
CADDY_VERSION=2-alpine

# --- Database ---------------------------------------------------------------
POSTGRES_DB=kestra
POSTGRES_USER=kestra
# Obbligatoria. Generane una con: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# --- Accesso all'interfaccia (basic auth, sempre attiva) --------------------
# Deve essere un indirizzo email valido.
KESTRA_ADMIN_EMAIL=admin@example.com
# Almeno 8 caratteri, con maiuscola, minuscola e numero.
KESTRA_ADMIN_PASSWORD=

# --- Rete / accesso remoto --------------------------------------------------
# 127.0.0.1 = solo locale (raggiungibile via tunnel SSH o dietro il profilo tls)
# 0.0.0.0   = esposto su tutte le interfacce di rete della macchina
KESTRA_BIND=127.0.0.1
KESTRA_PORT=8080

# URL pubblico con cui raggiungi Kestra: usato nei link della UI e nei webhook.
# Esempi: http://IP_DEL_SERVER:8080/  oppure  https://kestra.tuodominio.it/
KESTRA_URL=http://localhost:8080/

# --- Profilo `tls` (HTTPS automatico con Caddy + Let's Encrypt) -------------
# Necessari solo se avvii con: docker compose --profile tls up -d
# Il dominio deve gia' puntare (record A/AAAA) a questo server, porte 80 e 443 aperte.
KESTRA_DOMAIN=
ACME_EMAIL=
